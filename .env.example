# ==============================================================================
# CAVENHUSRT - Environment Variables Configuration (.env.example)
# ==============================================================================

# Supabase Public Configuration (Frontend)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Supabase Server-Side Configuration (Private - Never expose to client!)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# PostgreSQL Database Connection Strings
# Transaction Pooler (Port 6543) - Recommended for Vercel / Serverless deployments:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Direct Connection (Port 5432) - Session connection:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"
# Vercel integration automatic variable:
POSTGRES_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Razorpay Payment Gateway
# Frontend Key ID (Used by Razorpay Checkout SDK)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
# Backend Credentials (Used for server-side order creation and cryptographic verification)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ShipMaxx360 Logistics & Shipping Integration
# API endpoints provided in your ShipMaxx360 / Losung360 merchant developer portal
SHIPMAXX360_BASE_URL="https://api.shipmaxx360.com"
SHIPMAXX360_API_KEY="your_shipmaxx360_api_key"
SHIPMAXX360_API_SECRET="your_shipmaxx360_api_secret"
SHIPMAXX360_WEBHOOK_SECRET="your_shipmaxx360_webhook_signature_secret"
SHIPMAXX360_PICKUP_PINCODE="521212"

# Google OAuth Authentication
VITE_GOOGLE_CLIENT_ID="your_google_web_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your_google_web_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Cryptographic Session Signing Secret (Required - Never expose to client!)
SESSION_SECRET="your-32-byte-hex-session-signing-secret"

# EmailJS OTP Email Delivery (Server-Side)
EMAILJS_SERVICE_ID="service_your_service_id"
EMAILJS_TEMPLATE_ID="template_your_template_id"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_PRIVATE_KEY="your_emailjs_private_key"

# Upstash Redis REST Credentials (Used for high-speed atomic OTP storage & rate limiting)
UPSTASH_REDIS_REST_URL="https://your-database-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Cron Security (Optional: for protecting scheduled server functions)
CRON_SECRET="your-secure-cron-bearer-token"
