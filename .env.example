# Supabase Configuration
# Found in your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Server-side Supabase credentials (used in server functions and middleware)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Database Connection (Direct or Transaction Pooler URL for Drizzle migrations)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# Razorpay Payment Gateway (Test or Live credentials from Razorpay Dashboard)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Shiprocket Shipping Integration (Shiprocket API User credentials)
SHIPROCKET_EMAIL="your-email@cavenhurst.in"
SHIPROCKET_PASSWORD="your-shiprocket-password"

# Cron Security (Optional: for protecting scheduled server functions)
CRON_SECRET="your-secure-cron-bearer-token"

